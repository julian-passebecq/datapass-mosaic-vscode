{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Datapass API Lab mission",
  "$comment": "Generated by scripts/authoring/gen_json_schemas.py from the runtime's pydantic model. Do not edit.",
  "$defs": {
    "Api": {
      "additionalProperties": false,
      "properties": {
        "scenario": {
          "title": "Scenario",
          "type": "string"
        },
        "seed": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "tables": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Tables",
          "type": "array"
        }
      },
      "required": [
        "scenario",
        "seed",
        "tables"
      ],
      "title": "Api",
      "type": "object"
    },
    "ApiLogCheck": {
      "additionalProperties": false,
      "description": "The simulated API's request log for one run of the learner's ingestion (the last one by default).",
      "properties": {
        "fail": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fail"
        },
        "kind": {
          "const": "api_log",
          "title": "Kind",
          "type": "string"
        },
        "endpoint": {
          "pattern": "^/v1/[a-z]{1,30}$",
          "title": "Endpoint",
          "type": "string"
        },
        "day": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Day"
        },
        "complete": {
          "default": false,
          "title": "Complete",
          "type": "boolean"
        },
        "saw_status": {
          "items": {
            "type": "integer"
          },
          "maxItems": 4,
          "title": "Saw Status",
          "type": "array"
        },
        "retried_5xx": {
          "default": false,
          "title": "Retried 5Xx",
          "type": "boolean"
        },
        "retry_after_respected": {
          "default": false,
          "title": "Retry After Respected",
          "type": "boolean"
        },
        "max_records": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Records"
        },
        "param_required": {
          "anyOf": [
            {
              "pattern": "^[a-z_]{1,40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Param Required"
        },
        "authorized": {
          "default": false,
          "title": "Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "endpoint"
      ],
      "title": "ApiLogCheck",
      "type": "object"
    },
    "ApiRunCheck": {
      "additionalProperties": false,
      "description": "The last run of the learner's ingestion finished without an error (on a given day of the API).",
      "properties": {
        "fail": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fail"
        },
        "kind": {
          "const": "api_run",
          "title": "Kind",
          "type": "string"
        },
        "day": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Day"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ApiRunCheck",
      "type": "object"
    },
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9-]{1,40}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "checks": {
          "items": {
            "discriminator": {
              "mapping": {
                "api_log": "#/$defs/ApiLogCheck",
                "api_run": "#/$defs/ApiRunCheck",
                "sql": "#/$defs/SqlCheck"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/SqlCheck"
              },
              {
                "$ref": "#/$defs/ApiLogCheck"
              },
              {
                "$ref": "#/$defs/ApiRunCheck"
              }
            ]
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "checks"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "Day": {
      "additionalProperties": false,
      "description": "A day of the simulated API. The first one starts the mission; later ones are loaded by the learner.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9-]{1,40}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "day": {
          "maximum": 5,
          "minimum": 1,
          "title": "Day",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "label",
        "day"
      ],
      "title": "Day",
      "type": "object"
    },
    "ReferenceStep": {
      "additionalProperties": false,
      "description": "How scripts/api_lab_smoke.py plays the answer: run an ingestion file, or load the next day of the API.",
      "properties": {
        "run": {
          "anyOf": [
            {
              "pattern": "^[a-z_/]{1,60}\\.py$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run"
        },
        "batch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch"
        }
      },
      "title": "ReferenceStep",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "check": {
          "discriminator": {
            "mapping": {
              "api_log": "#/$defs/ApiLogCheck",
              "api_run": "#/$defs/ApiRunCheck",
              "sql": "#/$defs/SqlCheck"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/SqlCheck"
            },
            {
              "$ref": "#/$defs/ApiLogCheck"
            },
            {
              "$ref": "#/$defs/ApiRunCheck"
            }
          ],
          "title": "Check"
        }
      },
      "required": [
        "message",
        "check"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "SqlCheck": {
      "additionalProperties": false,
      "description": "Read-only SQL on the workspace catalog, compared (order-independent) to the expected rows.",
      "properties": {
        "fail": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fail"
        },
        "kind": {
          "const": "sql",
          "title": "Kind",
          "type": "string"
        },
        "sql": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Sql",
          "type": "string"
        },
        "expected": {
          "items": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object"
          },
          "maxItems": 60,
          "title": "Expected",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "sql",
        "expected"
      ],
      "title": "SqlCheck",
      "type": "object"
    },
    "Ticket": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "maxLength": 120,
          "minLength": 1,
          "title": "From",
          "type": "string"
        },
        "subject": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "body": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "maxLength": 12000,
          "minLength": 1,
          "title": "Body"
        }
      },
      "required": [
        "from",
        "subject",
        "body"
      ],
      "title": "Ticket",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
      "title": "Id",
      "type": "string"
    },
    "version": {
      "maxLength": 20,
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "lab": {
      "const": "apilab",
      "title": "Lab",
      "type": "string"
    },
    "title": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "level": {
      "enum": [
        "intro",
        "intermediate",
        "advanced"
      ],
      "title": "Level",
      "type": "string"
    },
    "estimate": {
      "maxLength": 40,
      "title": "Estimate",
      "type": "string"
    },
    "skills": {
      "items": {
        "type": "string"
      },
      "maxItems": 10,
      "title": "Skills",
      "type": "array"
    },
    "ticket": {
      "$ref": "#/$defs/Ticket"
    },
    "acceptance": {
      "items": {
        "$ref": "#/$defs/Criterion"
      },
      "maxItems": 10,
      "minItems": 1,
      "title": "Acceptance",
      "type": "array"
    },
    "requires": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "maxItems": 6,
      "title": "Requires",
      "type": "array"
    },
    "hints": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Hints",
      "type": "array"
    },
    "api": {
      "$ref": "#/$defs/Api"
    },
    "batches": {
      "items": {
        "$ref": "#/$defs/Day"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Batches",
      "type": "array"
    },
    "reference": {
      "items": {
        "$ref": "#/$defs/ReferenceStep"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Reference",
      "type": "array"
    }
  },
  "required": [
    "id",
    "version",
    "lab",
    "title",
    "level",
    "estimate",
    "ticket",
    "acceptance",
    "api",
    "batches",
    "reference"
  ],
  "type": "object"
}
