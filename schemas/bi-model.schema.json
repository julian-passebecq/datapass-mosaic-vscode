{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Datapass BI Lab star model (bi/model.json)",
  "$comment": "Generated by scripts/authoring/gen_json_schemas.py from the runtime's pydantic model. Do not edit.",
  "$defs": {
    "ModelTable": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^(source|bronze|silver|gold|warehouse|features|metrics)\\.[a-z][a-z0-9_]{0,62}$",
          "title": "Name",
          "type": "string"
        },
        "role": {
          "enum": [
            "fact",
            "dimension",
            "bridge"
          ],
          "title": "Role",
          "type": "string"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "business_key": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Business Key",
          "type": "array"
        },
        "grain": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "title": "Grain",
          "type": "array"
        },
        "unknown_member": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unknown Member"
        },
        "scd": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScdSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "default": "",
          "maxLength": 400,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "name",
        "role"
      ],
      "title": "ModelTable",
      "type": "object"
    },
    "Relationship": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "pattern": "^((?:source|bronze|silver|gold|warehouse|features|metrics)\\.[a-z][a-z0-9_]{0,62})\\.([a-z][a-z0-9_]{0,62})$",
          "title": "From",
          "type": "string"
        },
        "to": {
          "pattern": "^((?:source|bronze|silver|gold|warehouse|features|metrics)\\.[a-z][a-z0-9_]{0,62})\\.([a-z][a-z0-9_]{0,62})$",
          "title": "To",
          "type": "string"
        },
        "cardinality": {
          "default": "many-to-one",
          "enum": [
            "many-to-one",
            "one-to-one",
            "one-to-many",
            "many-to-many"
          ],
          "title": "Cardinality",
          "type": "string"
        },
        "cross_filter": {
          "default": "single",
          "enum": [
            "single",
            "both"
          ],
          "title": "Cross Filter",
          "type": "string"
        },
        "active": {
          "default": true,
          "title": "Active",
          "type": "boolean"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "Relationship",
      "type": "object"
    },
    "ScdSpec": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            0,
            1,
            2,
            3,
            6
          ],
          "title": "Type",
          "type": "integer"
        },
        "valid_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        },
        "current_flag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Flag"
        },
        "open_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "9999-12-31",
          "title": "Open End"
        }
      },
      "required": [
        "type"
      ],
      "title": "ScdSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "name": {
      "default": "model",
      "maxLength": 80,
      "title": "Name",
      "type": "string"
    },
    "description": {
      "default": "",
      "maxLength": 1000,
      "title": "Description",
      "type": "string"
    },
    "tables": {
      "items": {
        "$ref": "#/$defs/ModelTable"
      },
      "maxItems": 24,
      "title": "Tables",
      "type": "array"
    },
    "relationships": {
      "items": {
        "$ref": "#/$defs/Relationship"
      },
      "maxItems": 48,
      "title": "Relationships",
      "type": "array"
    }
  },
  "type": "object"
}
