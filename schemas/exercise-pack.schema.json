{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Datapass exercise pack manifest",
  "$comment": "Generated by scripts/authoring/gen_json_schemas.py from the runtime's pydantic model. Do not edit.",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-zA-Z0-9_-]+$",
      "title": "Id",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "provenance": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Provenance",
      "type": "object"
    }
  },
  "required": [
    "id",
    "version",
    "title"
  ],
  "type": "object"
}
