{
  "demo-sum": {
    "solution": "SELECT COALESCE(SUM(value), 0) AS total FROM input",
    "fixtures": [
      {
        "id": "example",
        "visibility": "visible",
        "input_rows": [
          {
            "value": 1
          },
          {
            "value": 2
          },
          {
            "value": 2
          },
          {
            "value": null
          }
        ],
        "expected": [
          {
            "total": 5
          }
        ]
      },
      {
        "id": "hidden-values",
        "visibility": "hidden",
        "input_rows": [
          {
            "value": -3
          },
          {
            "value": 7
          },
          {
            "value": 7
          },
          {
            "value": 5
          },
          {
            "value": null
          }
        ],
        "expected": [
          {
            "total": 16
          }
        ]
      },
      {
        "id": "empty-input",
        "visibility": "edge",
        "input_rows": [],
        "expected": [
          {
            "total": 0
          }
        ]
      }
    ]
  },
