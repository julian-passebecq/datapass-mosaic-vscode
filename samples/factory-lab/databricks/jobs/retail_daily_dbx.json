{
  "name": "retail_daily_dbx",
  "description": "Daily retail load: ingest, check for new rows, silver, gold and a SQL check on a warehouse.",
  "parameters": [
    {
      "name": "run_date",
      "default": "{{job.start_time.iso_date}}"
    },
    {
      "name": "min_amount",
      "default": "0"
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "etl_cluster",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "Standard_DS3_v2",
        "num_workers": 2
      }
    }
  ],
  "tasks": [
    {
      "task_key": "ingest_orders",
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/nb_ingest_orders"
      },
      "max_retries": 1,
      "min_retry_interval_millis": 60000
    },
    {
      "task_key": "has_new_rows",
      "depends_on": [
        {
          "task_key": "ingest_orders"
        }
      ],
      "condition_task": {
        "op": "GREATER_THAN",
        "left": "{{tasks.ingest_orders.values.new_rows}}",
        "right": "0"
      }
    },
    {
      "task_key": "silver_orders",
      "depends_on": [
        {
          "task_key": "has_new_rows",
          "outcome": "true"
        }
      ],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/nb_silver_orders_dbx",
        "base_parameters": {
          "run_date": "{{job.parameters.run_date}}"
        }
      }
    },
    {
      "task_key": "gold_revenue",
      "depends_on": [
        {
          "task_key": "silver_orders"
        }
      ],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/nb_gold_revenue"
      }
    },
    {
      "task_key": "gold_checks",
      "depends_on": [
        {
          "task_key": "gold_revenue"
        }
      ],
      "sql_task": {
        "file": {
          "path": "/Workspace/Shared/sql/gold_checks.sql"
        },
        "warehouse_id": "serverless-sql",
        "parameters": {
          "min_segments": "2"
        }
      }
    },
    {
      "task_key": "alert_on_failure",
      "run_if": "AT_LEAST_ONE_FAILED",
      "depends_on": [
        {
          "task_key": "ingest_orders"
        },
        {
          "task_key": "silver_orders"
        },
        {
          "task_key": "gold_revenue"
        }
      ],
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/nb_alert"
      }
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "UTC",
    "pause_status": "PAUSED"
  },
  "tags": {
    "domain": "retail"
  }
}
