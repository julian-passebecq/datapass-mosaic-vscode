{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Datapass Case v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "modules",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "version": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "id",
          "module",
          "language",
          "code",
          "depends_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "module": {
            "type": "string"
          },
          "language": {
            "enum": [
              "sql",
              "sparklab",
              "python",
              "polars",
              "dbt"
            ]
          },
          "code": {
            "type": "string",
            "maxLength": 40000
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output_asset": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}