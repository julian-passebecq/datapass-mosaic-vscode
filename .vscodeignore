.github/**
# Claude Code settings and the worktrees of parallel sessions (full repository copies).
.claude/**
# Local Python environments (the runtime installs into its own managed venv).
.venv/**
**/.venv/**
.vscode/**
src/**
scripts/**
legacy-donors/**
migration-sources/**
workbench-core/**
node_modules/**
runtime/**/__pycache__/**
runtime/**/*.pyc
# Project reference answers and walkthroughs are for scripts/projects_smoke.py, not for learners.
content/projects/*/reference/**
# Mission reference solutions and mutants are for scripts/missions_smoke.py, not for learners.
content/missions/*/*/solution/**
content/missions/*/*/mutants/**
*.vsix
dist-test/**
# Local build output from `pip install ./runtime`; the managed venv installs from source.
runtime/build/**
runtime/**/*.egg-info/**
# Source maps and TypeScript sources are bundled into dist/ and not needed at runtime.
**/*.map
packages/**
tsconfig.json
.gitignore
CLAUDE.md
# Contributor docs stay in the repository; users get the README and the quickstart.
docs/**
!docs/QUICKSTART.md
.vscode-test/**
test-results/**
