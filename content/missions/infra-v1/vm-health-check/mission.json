            "type": "Microsoft.Compute/virtualMachines", "tf_type": "azurerm_linux_virtual_machine",
            "id": "/subscriptions/6d1f2c3a-0b4e-4c8d-9a7f-2e5b8c1d4f60/resourceGroups/rg-reporting-prod/providers/Microsoft.Compute/virtualMachines/vm-report-app-02",
            "managed_by": "terraform", "created_at": "2025-03-04T09:00:00Z",
