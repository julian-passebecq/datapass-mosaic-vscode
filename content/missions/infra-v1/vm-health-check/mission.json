  },
  "reference": [
    {"infra": "az vm list -g rg-reporting-prod -o table"},
    {"infra": "az vm show -g rg-reporting-prod -n vm-report-app-01"},
    {"infra": "az monitor metrics list-definitions --resource vm-report-app-01"},
    {"infra": "az monitor metrics list --resource vm-report-app-01 --metric \"Percentage CPU\" --interval 1h"},
    {"infra": "az monitor metrics list --resource vm-report-app-02 --metric \"Percentage CPU\" --interval 1h"},
    {"infra": "az monitor metrics list --resource vm-report-app-01 --metric \"Percentage CPU\" --interval 5m --start-time 2026-10-12T02:00:00Z --end-time 2026-10-12T03:30:00Z"},
    {"infra": "az vm restart -g rg-reporting-prod -n vm-report-app-01"},
    {"infra": "az vm list -g rg-reporting-prod -o table"}
  ]
