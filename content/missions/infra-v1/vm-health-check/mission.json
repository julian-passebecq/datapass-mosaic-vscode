                  "unit": "Percent", "description": "The percentage of allocated compute units in use by the VM",
                  "base": 31, "noise": 7, "max": 100,
                  "events": [{"from": "2026-10-11T22:00:00Z", "minutes": 30, "value": 68, "noise": 6}]
                },
                "Available Memory Bytes": {
                  "unit": "Bytes", "description": "Memory available to applications (32 GiB VM)",
                  "base": 11500000000.0, "noise": 300000000.0, "min": 0
