      "id": "aggregate",
      "title": "Build customer revenue in Gold",
      "module": "fabric-notebook",
      "language": "sparklab",
      "code": "from pyspark.sql import functions as F\norders = spark.table(\"silver.orders\")\ncustomer_revenue = orders.groupBy(\"customer_id\").agg(F.sum(\"net_amount\").alias(\"revenue\"), F.count(\"order_id\").alias(\"orders\"))",
      "solution": "from pyspark.sql import functions as F\norders = spark.table(\"silver.orders\")\ncustomer_revenue = orders.groupBy(\"customer_id\").agg(F.sum(\"net_amount\").alias(\"revenue\"), F.count(\"order_id\").alias(\"orders\"))",
      "output_asset": "gold.customer_revenue",
      "depends_on": [
        "clean"
      ],
      "concept": "A groupBy can introduce a shuffle in distributed Spark. Here the actual result is computed over the small workspace fixture.",
      "task": "Produce one row per customer with revenue and order count.",
      "hint": "Group by customer_id, not by order_id.",
