  "af-data-interval-timetable": {
    "solution": "from datetime import datetime\n\nfrom airflow.sdk import DAG\nfrom airflow.providers.common.sql.operators.sql import SQLExecuteQueryOperator\nfrom airflow.timetables.interval import CronDataIntervalTimetable\n\nwith DAG(\n    dag_id=\"daily_sales_load\",\n    schedule=CronDataIntervalTimetable(\"0 0 * * *\", timezone=\"UTC\"),\n    start_date=datetime(2026, 3, 1),\n    catchup=True,\n) as dag:\n    SQLExecuteQueryOperator(\n        task_id=\"load_day\",\n        conn_id=\"warehouse\",\n        sql=(\n            \"INSERT INTO daily_sales SELECT * FROM sales \"\n            \"WHERE sold_at >= '{{ data_interval_start | ds }}' AND sold_at < '{{ data_interval_end | ds }}'\"\n        ),\n    )\n",
    "fixtures": [
      {
        "id": "first-days",
        "visibility": "visible",
        "input_rows": [],
        "scenario": {
          "now": "2026-03-03T12:00:00Z",
          "outcome": "rendered",
          "columns": [
            "logical_date",
            "value"
          ]
        },
        "expected": [
          {
            "logical_date": "2026-03-01T00:00:00+00:00",
            "value": "INSERT INTO daily_sales SELECT * FROM sales WHERE sold_at >= '2026-03-01' AND sold_at < '2026-03-02'"
          },
          {
            "logical_date": "2026-03-02T00:00:00+00:00",
            "value": "INSERT INTO daily_sales SELECT * FROM sales WHERE sold_at >= '2026-03-02' AND sold_at < '2026-03-03'"
          }
        ]
      },
      {
        "id": "one-interval-exactly",
        "visibility": "hidden",
        "input_rows": [],
        "scenario": {
          "now": "2026-03-02T00:00:00Z",
          "outcome": "rendered",
          "columns": [
            "logical_date",
            "value"
          ]
        },
        "expected": [
          {
            "logical_date": "2026-03-01T00:00:00+00:00",
            "value": "INSERT INTO daily_sales SELECT * FROM sales WHERE sold_at >= '2026-03-01' AND sold_at < '2026-03-02'"
          }
        ]
      },
      {
