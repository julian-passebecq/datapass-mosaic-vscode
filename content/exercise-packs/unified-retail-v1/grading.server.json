    "solutions": {
      "sql": "SELECT order_id, customer_id, amount FROM input WHERE customer_id IS NOT NULL AND amount > 0",
      "python": "import pandas as pd\ndf = pd.DataFrame(input_rows, columns=[\"order_id\", \"customer_id\", \"amount\"])\nvalid = df[df[\"customer_id\"].notna() & (df[\"amount\"] > 0)]\ndisplay(valid[[\"order_id\", \"customer_id\", \"amount\"]])",
      "polars": "import polars as pl\ndf = pl.DataFrame(input_rows, schema={\"order_id\":pl.Int64,\"customer_id\":pl.Int64,\"amount\":pl.Float64})\nvalid = df.lazy().filter(pl.col(\"customer_id\").is_not_null() & (pl.col(\"amount\") > 0))\ndisplay(valid.select(\"order_id\", \"customer_id\", \"amount\").collect())",
      "sparklab": "df = spark.table(\"input\")\nvalid = df.filter(F.col(\"customer_id\").isNotNull() & (F.col(\"amount\") > 0))\nvalid.select(\"order_id\", \"customer_id\", \"amount\")",
      "dbt": "SELECT order_id, customer_id, amount FROM {{ ref('input') }} WHERE customer_id IS NOT NULL AND amount > 0"
    },
