  "retail-customer-revenue": {
    "solutions": {
      "sql": "SELECT customer_id, SUM(amount) AS revenue FROM input WHERE customer_id IS NOT NULL AND amount > 0 GROUP BY customer_id",
      "python": "import pandas as pd\ndf = pd.DataFrame(input_rows, columns=[\"order_id\", \"customer_id\", \"amount\"])\nvalid = df[df[\"customer_id\"].notna() & (df[\"amount\"] > 0)]\ndisplay(valid.groupby(\"customer_id\", as_index=False)[\"amount\"].sum().rename(columns={\"amount\":\"revenue\"}))",
      "polars": "import polars as pl\ndf = pl.DataFrame(input_rows, schema={\"order_id\":pl.Int64,\"customer_id\":pl.Int64,\"amount\":pl.Float64})\nvalid = df.lazy().filter(pl.col(\"customer_id\").is_not_null() & (pl.col(\"amount\") > 0))\ndisplay(valid.group_by(\"customer_id\").agg(pl.col(\"amount\").sum().alias(\"revenue\")).collect())",
      "sparklab": "df = spark.table(\"input\")\nvalid = df.filter(F.col(\"customer_id\").isNotNull() & (F.col(\"amount\") > 0))\nvalid.groupBy(\"customer_id\").agg(F.sum(\"amount\").alias(\"revenue\"))",
      "dbt": "SELECT customer_id, SUM(amount) AS revenue FROM {{ ref('input') }} WHERE customer_id IS NOT NULL AND amount > 0 GROUP BY customer_id"
