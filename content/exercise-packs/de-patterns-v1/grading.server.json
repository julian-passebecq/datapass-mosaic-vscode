  "de-sessionize-clicks": {
    "solution": "WITH flagged AS (\n  SELECT user_id, event_at,\n         CASE WHEN event_at - LAG(event_at) OVER w <= INTERVAL 30 MINUTE THEN 0 ELSE 1 END AS starts_session\n  FROM clicks\n  WINDOW w AS (PARTITION BY user_id ORDER BY event_at)\n), numbered AS (\n  SELECT user_id, event_at,\n         SUM(starts_session) OVER (PARTITION BY user_id ORDER BY event_at ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS session_no\n  FROM flagged\n)\nSELECT user_id, session_no, MIN(event_at) AS session_start, MAX(event_at) AS session_end, COUNT(*) AS events\nFROM numbered\nGROUP BY user_id, session_no",
    "fixtures": [
      {
