  "de-funnel-conversion": {
    "solution": "WITH per_user AS (\n  SELECT user_id,\n         BOOL_OR(step = 'view') AS viewed,\n         BOOL_OR(step = 'cart') AS carted,\n         BOOL_OR(step = 'purchase') AS bought\n  FROM events GROUP BY user_id\n), totals AS (\n  SELECT COUNT(*) FILTER (WHERE viewed) AS viewers,\n         COUNT(*) FILTER (WHERE viewed AND carted) AS carts,\n         COUNT(*) FILTER (WHERE viewed AND carted AND bought) AS buyers\n  FROM per_user\n)\nSELECT 'view' AS step, viewers AS users, ROUND(100.0 * viewers / NULLIF(viewers, 0), 1) AS pct_of_viewers FROM totals\nUNION ALL SELECT 'cart', carts, ROUND(100.0 * carts / NULLIF(viewers, 0), 1) FROM totals\nUNION ALL SELECT 'purchase', buyers, ROUND(100.0 * buyers / NULLIF(viewers, 0), 1) FROM totals",
