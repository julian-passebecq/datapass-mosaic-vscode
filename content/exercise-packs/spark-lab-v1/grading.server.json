  "spark-null-safe-change-detection": {
    "solution": "from pyspark.sql import functions as F\nold = spark.table(\"yesterday\").withColumnRenamed(\"email\", \"old_email\")\nnew = spark.table(\"today\").withColumnRenamed(\"email\", \"new_email\")\nresult = old.join(new, on=\"customer_id\", how=\"inner\").filter(~F.col(\"old_email\").eqNullSafe(F.col(\"new_email\")))\n",
    "fixtures": [
      {
        "id": "example",
        "visibility": "visible",
        "input_rows": [],
        "tables": {
          "yesterday": [
            {
              "customer_id": 1,
              "email": "ana@a.io"
            },
            {
              "customer_id": 2,
              "email": "bo@b.io"
            },
            {
              "customer_id": 3,
              "email": null
            }
          ],
          "today": [
            {
              "customer_id": 1,
              "email": "ana@a.io"
            },
            {
              "customer_id": 2,
              "email": "bo@new.io"
            },
            {
              "customer_id": 3,
              "email": "cy@c.io"
            }
          ]
        },
        "expected": [
          {
            "customer_id": 2,
            "old_email": "bo@b.io",
            "new_email": "bo@new.io"
          },
          {
            "customer_id": 3,
            "old_email": null,
            "new_email": "cy@c.io"
          }
        ]
      },
      {
        "id": "cleared-and-unchanged-null",
        "visibility": "hidden",
        "input_rows": [],
        "tables": {
          "yesterday": [
            {
              "customer_id": 4,
              "email": "di@d.io"
            },
            {
              "customer_id": 5,
              "email": null
            },
            {
              "customer_id": 6,
              "email": "ed@e.io"
            }
          ],
          "today": [
            {
              "customer_id": 4,
              "email": null
            },
            {
              "customer_id": 5,
              "email": null
            },
            {
              "customer_id": 6,
              "email": "ed@e.io"
            },
            {
              "customer_id": 7,
              "email": "new@x.io"
            }
          ]
        },
        "expected": [
          {
            "customer_id": 4,
            "old_email": "di@d.io",
            "new_email": null
          }
        ]
      },
      {
        "id": "nothing-changed",
        "visibility": "edge",
        "input_rows": [],
        "tables": {
          "yesterday": [
            {
              "customer_id": 8,
              "email": "x@x.io"
            }
          ],
          "today": [
            {
              "customer_id": 8,
              "email": "x@x.io"
            }
          ]
        },
        "expected": []
      }
    ]
  },
  "spark-full-outer-reconcile": {
    "solution": "from pyspark.sql import functions as F\nbilling = spark.table(\"billing\")\nledger = spark.table(\"ledger\")\njoined = billing.join(ledger, on=\"invoice_id\", how=\"full\")\nresult = joined.withColumn(\n    \"status\",\n    F.when(F.col(\"booked_amount\").isNull(), \"missing_in_ledger\")\n    .when(F.col(\"billed_amount\").isNull(), \"missing_in_billing\")\n    .when(F.col(\"billed_amount\") != F.col(\"booked_amount\"), \"amount_mismatch\")\n    .otherwise(\"match\"),\n)\n",
    "fixtures": [
      {
        "id": "example",
        "visibility": "visible",
        "input_rows": [],
        "tables": {
          "billing": [
            {
              "invoice_id": 1,
              "billed_amount": 100.0
            },
            {
              "invoice_id": 2,
              "billed_amount": 50.0
            },
            {
              "invoice_id": 3,
              "billed_amount": 75.0
            }
          ],
          "ledger": [
            {
              "invoice_id": 1,
              "booked_amount": 100.0
            },
            {
              "invoice_id": 2,
              "booked_amount": 45.0
            },
            {
              "invoice_id": 4,
              "booked_amount": 20.0
            }
          ]
        },
        "expected": [
          {
            "invoice_id": 1,
            "billed_amount": 100.0,
            "booked_amount": 100.0,
            "status": "match"
          },
          {
            "invoice_id": 2,
            "billed_amount": 50.0,
            "booked_amount": 45.0,
            "status": "amount_mismatch"
          },
          {
            "invoice_id": 3,
            "billed_amount": 75.0,
            "booked_amount": null,
            "status": "missing_in_ledger"
          },
          {
            "invoice_id": 4,
            "billed_amount": null,
            "booked_amount": 20.0,
            "status": "missing_in_billing"
          }
        ]
      },
      {
        "id": "disjoint-systems",
        "visibility": "hidden",
        "input_rows": [],
        "tables": {
          "billing": [
            {
              "invoice_id": 10,
              "billed_amount": 10.0
            }
          ],
          "ledger": [
            {
              "invoice_id": 11,
              "booked_amount": 11.0
            },
            {
              "invoice_id": 12,
              "booked_amount": 12.0
            }
          ]
        },
        "expected": [
          {
            "invoice_id": 11,
            "billed_amount": null,
            "booked_amount": 11.0,
            "status": "missing_in_billing"
          },
          {
            "invoice_id": 12,
            "billed_amount": null,
            "booked_amount": 12.0,
            "status": "missing_in_billing"
          },
          {
            "invoice_id": 10,
            "billed_amount": 10.0,
            "booked_amount": null,
            "status": "missing_in_ledger"
          }
        ]
      },
      {
        "id": "empty-billing",
        "visibility": "edge",
        "input_rows": [],
        "tables": {
          "billing": [],
          "ledger": [
            {
              "invoice_id": 20,
              "booked_amount": 5.0
            }
          ]
        },
        "expected": [
          {
            "invoice_id": 20,
            "billed_amount": null,
            "booked_amount": 5.0,
            "status": "missing_in_billing"
          }
        ]
      }
    ]
  },
  "spark-join-fanout-before-sum": {
    "solution": "from pyspark.sql import functions as F\norders = spark.table(\"orders\")\npromos = spark.table(\"order_promos\")\npromo_counts = promos.groupBy(\"order_id\").agg(F.count(\"*\").alias(\"promo_count\"))\nresult = (\n    orders.join(promo_counts, on=\"order_id\", how=\"left\")\n    .groupBy(\"customer_id\")\n    .agg(F.sum(\"amount\").alias(\"revenue\"), F.sum(F.coalesce(F.col(\"promo_count\"), F.lit(0))).alias(\"promo_uses\"))\n)\n",
    "fixtures": [
      {
        "id": "example",
        "visibility": "visible",
        "input_rows": [],
        "tables": {
          "orders": [
            {
              "order_id": 1,
              "customer_id": 10,
              "amount": 100.0
            },
            {
              "order_id": 2,
              "customer_id": 10,
              "amount": 50.0
            },
            {
              "order_id": 3,
              "customer_id": 20,
              "amount": 80.0
            }
          ],
          "order_promos": [
            {
              "order_id": 1,
              "promo_code": "SPRING"
            },
            {
              "order_id": 1,
              "promo_code": "VIP"
            },
            {
              "order_id": 3,
              "promo_code": "SPRING"
            }
          ]
        },
        "expected": [
          {
            "customer_id": 10,
            "revenue": 150.0,
            "promo_uses": 2
          },
          {
            "customer_id": 20,
            "revenue": 80.0,
            "promo_uses": 1
          }
        ]
      },
      {
        "id": "three-promos-and-none",
        "visibility": "hidden",
        "input_rows": [],
        "tables": {
          "orders": [
            {
              "order_id": 4,
