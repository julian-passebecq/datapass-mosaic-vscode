  "spark-running-total-ties": {
    "solution": "from pyspark.sql import functions as F\nfrom pyspark.sql.window import Window\ntransactions = spark.table(\"transactions\")\nw = (\n    Window.partitionBy(\"account_id\")\n    .orderBy(\"txn_date\", \"txn_id\")\n    .rowsBetween(Window.unboundedPreceding, Window.currentRow)\n)\nresult = transactions.withColumn(\"running_balance\", F.sum(\"amount\").over(w))\n",
    "fixtures": [
      {
        "id": "example",
        "visibility": "visible",
        "input_rows": [],
        "tables": {
          "transactions": [
            {
              "account_id": "A",
              "txn_id": 1,
              "txn_date": "2026-01-01",
              "amount": 100.0
            },
            {
              "account_id": "A",
              "txn_id": 2,
              "txn_date": "2026-01-02",
              "amount": -30.0
            },
            {
              "account_id": "A",
              "txn_id": 3,
              "txn_date": "2026-01-02",
              "amount": 50.0
            },
            {
              "account_id": "B",
              "txn_id": 4,
              "txn_date": "2026-01-01",
              "amount": 10.0
            }
          ]
        },
        "expected": [
          {
            "account_id": "B",
            "txn_id": 4,
            "txn_date": "2026-01-01",
            "amount": 10.0,
            "running_balance": 10.0
          },
          {
            "account_id": "A",
            "txn_id": 1,
            "txn_date": "2026-01-01",
            "amount": 100.0,
            "running_balance": 100.0
          },
          {
            "account_id": "A",
            "txn_id": 2,
