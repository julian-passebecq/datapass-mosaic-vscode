  "spark-count-column-vs-star": {
    "solution": "from pyspark.sql import functions as F\nevents = spark.table(\"events\")\nresult = events.groupBy(\"campaign_id\").agg(F.count(\"*\").alias(\"impressions\"), F.count(\"clicked_at\").alias(\"clicks\"))\n",
